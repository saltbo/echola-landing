---
import { apps } from '../lib/apps';
import ThemeToggle from '../components/ui/shared/ThemeToggle';
const title = 'TFTT Apps';
const description = 'Thoughtful apps for everyday learning. Explore our products and find your next companion.';
const canonicalURL = new URL('/', Astro.site ?? Astro.url);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'system';
      const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.add(dark ? 'dark' : 'light');
    </script>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 dark:bg-black dark:text-white">
    <div class="mx-auto max-w-5xl px-6 sm:px-10">
      <header class="flex items-center justify-between gap-4 border-b border-gray-200 py-6 dark:border-gray-800">
        <a href="/" class="text-lg font-semibold tracking-tight">TFTT Apps</a>
        <ThemeToggle client:load />
      </header>
      <main class="py-16 sm:py-24">
        <div class="mb-12 max-w-2xl">
          <p class="mb-4 text-sm font-medium text-gray-500 dark:text-gray-400">OUR APPS</p>
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">A little more possibility.</h1>
          <p class="mt-5 text-lg leading-relaxed text-gray-600 dark:text-gray-400">Thoughtful tools for learning, watching, and making progress every day.</p>
        </div>
        <ul class="grid gap-6 sm:grid-cols-2" aria-label="Our apps">
          {apps.map(({ slug, appData }) => (
            <li>
              <a href={`/${slug}/`} class="group flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-7 transition-colors hover:border-gray-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-700 dark:border-gray-800 dark:bg-gray-950 dark:hover:border-gray-600 dark:focus-visible:outline-gray-300" aria-label={`Explore ${appData.name}`}>
                <img src={appData.logo} alt="" width="72" height="72" class="mb-6 h-[72px] w-[72px] rounded-2xl object-cover" />
                <h2 class="text-2xl font-semibold tracking-tight">{appData.name}</h2>
                <p class="mb-8 mt-3 flex-1 text-base leading-relaxed text-gray-600 dark:text-gray-400">{appData.description}</p>
                <span class="flex items-center justify-between text-sm font-medium">Explore app <span aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </main>
      <footer class="border-t border-gray-200 py-6 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">© {new Date().getFullYear()} TFTT Apps</footer>
    </div>
  </body>
</html>
